{
  "name": "localbite",
  "private": true,
  "workspaces": [
    "app",
    "backend",
    "admin",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @localbite/backend",
    "db:migrate": "npm run db:migrate -w @localbite/backend",
    "db:seed": "npm run db:seed -w @localbite/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:admin": "npm run dev -w @localbite/admin",
    "tunnel": "npx --yes localtunnel --port 3001 --host https://loca.lt --subdomain localbite-aykut-dev"
  },
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
