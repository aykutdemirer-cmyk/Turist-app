DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localbite?schema=public"
PORT=3001
HOST=0.0.0.0
# Virgülle ayrılmış liste veya * (geliştirme)
CORS_ORIGIN=*

# JWT imzalama anahtarı (en az 32 karakter). Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Google ile giriş (opsiyonel; boşsa /auth/google 501 döner). Virgülle birden fazla client ID verilebilir.
GOOGLE_CLIENT_ID=

# ─── Sosyal giriş (tarayıcı tabanlı OAuth) ───
# Sağlayıcı panellerine kaydedilecek callback adresleri:
#   Google: {PUBLIC_API_URL}/api/v1/auth/oauth/google/callback   (OAuth istemci türü: Web application)
#   GitHub: {PUBLIC_API_URL}/api/v1/auth/oauth/github/callback   (Settings → Developer settings → OAuth Apps)
# Emülatörde adb reverse tcp:3001 tcp:3001 ile localhost cihazdan da çalışır.
PUBLIC_API_URL=http://localhost:3001
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Yasal sayfalar ve silme talepleri için iletişim adresi (yayından önce gerçek adres)
LEGAL_CONTACT_EMAIL=privacy@localbite.example

# Yönetici paneli (web) için sosyal giriş dönüş adresleri, virgülle (tam origin)
OAUTH_WEB_ORIGINS=http://localhost:5173

# Canlı gerçek mekanlar (OpenStreetMap, ücretsiz)
LIVE_PLACES_ENABLED=true
# OSM mekanlarını arka planda veritabanına aktar
OSM_IMPORT_ENABLED=true
