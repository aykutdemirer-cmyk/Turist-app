DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localbite?schema=public"
PORT=3000
HOST=0.0.0.0
# Virgülle ayrılmış liste veya * (geliştirme)
CORS_ORIGIN=*

# JWT imzalama anahtarı (en az 32 karakter). Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Google ile giriş (opsiyonel; boşsa /auth/google 501 döner). Virgülle birden fazla client ID verilebilir.
GOOGLE_CLIENT_ID=
