// LocalBite / StreetSpot — veri modeli
// Mimari notlar için: docs/ARCHITECTURE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enum'lar
// ─────────────────────────────────────────────

enum VenueType {
  HOME_COOKING // 🍲 Esnaf lokantası / sulu yemek
  STREET_CART // 🍢 Seyyar araba, büfe, kiosk
  LOCAL_BURGER_WRAP // 🍔 Mahalle burgercisi, dürümcü
  DESSERT_TEA // 🍮 Baklava, sütlü tatlı, çay ocağı
}

/// Pahalı seviye bilinçli olarak YOK — uygulamanın temel kuralı.
enum PriceLevel {
  BUDGET // $
  MODERATE // $$
}

enum LocalTip {
  CASH_ONLY
  PAY_AT_COUNTER
  NO_RESERVATIONS
  SELF_SERVICE_TRAY
  SHARED_TABLES
  POINT_TO_ORDER // Menü yok, vitrinden gösterip sipariş
  CLOSES_WHEN_SOLD_OUT
  LUNCH_ONLY
  STANDING_ONLY
}

enum VenueStatus {
  PENDING_APPROVAL // Kullanıcı/esnaf başvurusu, Super Admin onayı bekliyor
  ACTIVE
  REJECTED
  CLOSED // Kalıcı olarak kapandı
}

/// Ana sayfa yemek kategorileri (bir mekan birden fazlasında olabilir).
/// STREET_CART saklanmaz: locationType = DYNAMIC_STREET olan her mekana API ekler.
enum FoodCategory {
  STEW // Tencere / sulu yemek
  DONER_WRAP // Döner & dürüm
  BURGER_TOAST // Sokak burgeri & tost
  PIDE_PIZZA // Taş fırın: pide & pizza
  SOUP // Çorbalar
  STREET_CART // Seyyar tezgahlar (türetilir)
  OLIVE_OIL_VEGAN // Zeytinyağlı / vegan
}

/// STATIC: sabit dükkan. DYNAMIC_STREET: seyyar; konumu gün içinde değişebilir.
enum LocationType {
  STATIC
  DYNAMIC_STREET
}

enum AnnouncementType {
  ANNOUNCEMENT // "Bugün 20:00'de sıcak lokma dökülüyor"
  PROMOTION // İndirim / fırsat
}

enum AnnouncementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportType {
  SPOTTED_TODAY // "Bugün burada gördüm" — seyyar teyidi
  UPVOTE // Genel beğeni / öneri
  NOT_HERE // "Gittim, yoktu"
  CLOSED // "Kalıcı olarak kapanmış"
}

enum Locale {
  en
  tr
}

/// Yorumun nereden geldiği; arayüzde kaynak etiketi olarak gösterilir.
enum ReviewSource {
  SAMPLE // Geliştirme/demo için yazılmış örnek yorum — gerçek bir kişiye ait değildir
  COMMUNITY // Uygulama kullanıcısının yorumu
  GOOGLE // Google Places API'den (atıf kurallarına uyularak) alınan yorum
}

enum UserRole {
  USER
  LOCAL_GUIDE // Topluluk tarafından güvenilen yerel rehber (rozet)
  VENDOR // Seyyar / esnaf: yalnızca sahibi olduğu mekanı yönetir
  SUPER_ADMIN // Genel yönetici: moderasyon, onaylar, sponsorluk
}

// ─────────────────────────────────────────────
// Kullanıcı
// Konuk: yalnızca deviceId (anonim teyit/öneri). Üye: e-posta+şifre veya Google.
// Konuk kayıt olduğunda aynı satır üyeye yükseltilir; geçmiş teyitleri korunur.
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  /// Konuk kimliği; başka cihazdan giriş yapan üyede null olabilir
  deviceId  String?  @unique
  fullName  String?
  avatarUrl String?
  role      UserRole @default(USER)
  locale    Locale   @default(en)

  /// Küçük harfe normalize edilir
  email           String?   @unique
  /// scrypt; Google ile gelen üyelerde null
  passwordHash    String?
  authProvider    String? // "google" | "email"
  authProviderId  String? // Google "sub"
  lastLoginAt     DateTime?
  /// Kullanım Şartları ve Topluluk Kuralları'nın kabul edildiği an (mağaza UGC politikası)
  termsAcceptedAt DateTime?
  /// Explorer Pass: null = ücretsiz. Tek seferlik satın almada uzak bir tarih yazılır.
  premiumUntil    DateTime?
  /// "mock" (geliştirme) | "app_store" | "google_play"
  premiumSource   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports         SpotReport[]
  submittedVenues Venue[]         @relation("SubmittedVenues")
  reviews         Review[]
  posts           Post[]
  comments        Comment[]
  postLikes       PostLike[]
  contentReports  ContentReport[] @relation("ReportedBy")
  resolvedReports ContentReport[] @relation("ResolvedBy")
  blocking        BlockedUser[]   @relation("Blocker")
  blockedBy       BlockedUser[]   @relation("Blocked")
  ownedVenues     Venue[]         @relation("OwnedVenues")

  @@unique([authProvider, authProviderId])
}

// ─────────────────────────────────────────────
// Mekan
// ─────────────────────────────────────────────

model Venue {
  id   String @id @default(cuid())
  slug String @unique
  name String // Yerel adı olduğu gibi: "Kadıköy Pilavcısı Hüseyin Usta"

  type         VenueType
  /// DYNAMIC_STREET = seyyar; konum VendorSchedule'a ya da satıcının canlı konumuna göre değişir
  locationType LocationType @default(STATIC)
  priceLevel   PriceLevel   @default(BUDGET)

  /// 1–100 yerellik puanı. Aralık kontrolü migration'da CHECK constraint ile.
  authenticityScore Int @default(70)

  // Ana / varsayılan konum. Seyyarlarda "genelde bulunduğu köşe".
  latitude     Float
  longitude    Float
  address      String?
  locationNote String? // "Rıhtım'daki vapur iskelesinin tam karşısı"
  neighborhood String? // Moda, Sultanahmet, Eminönü...
  district     String? // Kadıköy, Fatih... (kullanıcı önerilerinde bilinmeyebilir)
  city         String  @default("Istanbul")

  localTips LocalTip[]
  phone     String?

  /// Yemek kategorileri (ana sayfa filtreleri)
  foodCategories FoodCategory[] @default([])

  /// Kişi başı ortalama harcama (TL, yaklaşık). Aralık kontrolü migration'da CHECK ile.
  avgPriceMinTry Int?
  avgPriceMaxTry Int?

  /// Kapak fotoğrafı (lisanslı/kendi çekimi). Yoksa uygulama illüstrasyon gösterir.
  coverImageUrl String?

  status VenueStatus @default(ACTIVE)

  /// Mekanı yöneten VENDOR üye
  ownerId String?
  owner   User?   @relation("OwnedVenues", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Satıcının gönderdiği canlı konum. Varsayılan konum (latitude/longitude) korunur; "sıfırla" ona döner.
  isLiveLocation     Boolean   @default(false)
  liveLatitude       Float?
  liveLongitude      Float?
  lastLocationUpdate DateTime?

  /// Satıcının "Açık/Kapalı" anahtarı; null = çalışma saatlerine göre. Belli süre sonra geçersiz sayılır.
  openOverride   Boolean?
  openOverrideAt DateTime?

  /// Esnaf sponsorlu öne çıkarma (ücretli); arayüzde "Sponsorlu" olarak etiketlenir
  isPromoted Boolean @default(false)

  // Topluluk sinyali (denormalize, SpotReport yazılırken güncellenir)
  lastSpottedAt DateTime?
  spottedCount  Int       @default(0)
  upvoteCount   Int       @default(0)

  submittedById String?
  submittedBy   User?   @relation("SubmittedVenues", fields: [submittedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations  VenueTranslation[]
  dishes        Dish[]
  schedules     VendorSchedule[]
  reports       SpotReport[]
  reviews       Review[]
  posts         Post[]
  announcements VendorAnnouncement[]

  @@index([latitude, longitude]) // bbox sorgusu için
  @@index([type, status])
  @@index([district])
  @@index([ownerId])
}

/// Satıcı duyurusu / fırsatı. Super Admin onaylayınca mekan detayında yayınlanır.
model VendorAnnouncement {
  id         String             @id @default(cuid())
  venueId    String
  title      String
  content    String
  type       AnnouncementType   @default(ANNOUNCEMENT)
  status     AnnouncementStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  /// Onay/ret anı; yayın süresi onaydan itibaren sayılır
  reviewedAt DateTime?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([venueId, status])
}

/// Turiste gösterilen açıklama metinleri (dil başına bir satır).
model VenueTranslation {
  id          String  @id @default(cuid())
  venueId     String
  locale      Locale
  tagline     String // "Locals' favorite late-night rice cart"
  description String?
  customTip   String? // Enum'a sığmayan ipuçları: "Ask for extra butter"

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, locale])
}

// ─────────────────────────────────────────────
// Yemek (Must-Try)
// ─────────────────────────────────────────────

model Dish {
  id             String   @id @default(cuid())
  venueId        String
  localName      String // "Kuru Fasulye" — menüde/tabelada göreceği ad
  isMustTry      Boolean  @default(true)
  sortOrder      Int      @default(0) // 1–3 öne çıkan yemek sırası
  priceTry       Decimal? @db.Decimal(8, 2) // TL; enflasyon nedeniyle opsiyonel
  /// Porsiyon bilgisi: "1 porsiyon · 350 g", "yarım ekmek"
  portion        String?
  isVegetarian   Boolean  @default(false)
  /// Yemek fotoğrafı. Göreli yol (/media/...) API adresine göre çözülür; yoksa uygulama illüstrasyon gösterir.
  imageUrl       String?
  /// Lisanslı fotoğrafın atfı: "Yazar · CC BY-SA 4.0" (CC lisansları görünür atıf ister)
  imageCredit    String?
  imageSourceUrl String?

  venue        Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  translations DishTranslation[]

  @@index([venueId, isMustTry, sortOrder])
}

model DishTranslation {
  id          String  @id @default(cuid())
  dishId      String
  locale      Locale
  name        String // "Stewed white beans"
  description String? // "Slow-cooked beans in tomato sauce, eaten with rice pilaf"

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, locale])
}

// ─────────────────────────────────────────────
// Çalışma saatleri (sabit mekanlar + seyyarlar)
// ─────────────────────────────────────────────

/// Hem dükkanların açılış saatlerini hem seyyarların "hangi gün, hangi köşede" bilgisini tutar.
/// Saatler gece yarısından itibaren dakika cinsinden: 19:00 = 1140.
/// closeMinute < openMinute ise gece yarısını aşar (19:00–02:00 → 1140–120).
model VendorSchedule {
  id          String @id @default(cuid())
  venueId     String
  dayOfWeek   Int // 0 = Pazar … 6 = Cumartesi (açılış gününe göre)
  openMinute  Int
  closeMinute Int

  // Seyyar o gün farklı bir köşedeyse; null ise Venue konumu geçerli.
  latitude     Float?
  longitude    Float?
  locationNote String? // "Cuma akşamları Bahariye çıkışında"

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, dayOfWeek])
}

// ─────────────────────────────────────────────
// Yorumlar
// ─────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  venueId        String
  authorName     String // "Elif K." — soyadı kısaltılmış
  /// 1–5, migration'da CHECK constraint ile
  rating         Int
  source         ReviewSource @default(COMMUNITY)
  /// GOOGLE için zorunlu atıf bağlantısı
  sourceUrl      String?
  originalLocale Locale
  publishedAt    DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  /// COMMUNITY yorumlarında yazan üye; SAMPLE/GOOGLE'da null
  userId         String?
  /// Moderasyonla kaldırıldı; listelerde görünmez
  removedAt      DateTime?

  venue        Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  translations ReviewTranslation[]

  /// Bir üye bir mekana tek yorum yazar (tekrar yazınca güncellenir). userId null satırlar serbest.
  @@unique([venueId, userId])
  @@index([venueId, publishedAt])
  @@index([userId])
}

/// Yorum metni dil başına; originalLocale satırı özgün metindir.
model ReviewTranslation {
  id       String @id @default(cuid())
  reviewId String
  locale   Locale
  text     String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, locale])
}

// ─────────────────────────────────────────────
// Topluluk / Lezzet Meclisi
// ─────────────────────────────────────────────

model Post {
  id       String  @id @default(cuid())
  userId   String
  title    String
  content  String
  /// Opsiyonel mekan etiketi
  venueId  String?
  imageUrl String?

  // Denormalize sayaçlar (akış sorgusunu hafif tutmak için)
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  /// Moderasyonla kaldırıldı; akışta görünmez
  removedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue    Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    PostLike[]

  @@index([createdAt])
  @@index([venueId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  /// Moderasyonla kaldırıldı
  removedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// "Katılıyorum" oyu: üye başına gönderi başına bir tane
model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Topluluk doğrulaması
// ─────────────────────────────────────────────

model SpotReport {
  id      String     @id @default(cuid())
  venueId String
  userId  String
  type    ReportType

  /// Yerel saatle "YYYY-MM-DD" (Europe/Istanbul). Aynı cihaz aynı gün aynı tip oyu bir kez verebilir.
  dayKey String

  // Raporlayanın konumu — mekana uzaklık kontrolü (ör. SPOTTED için ≤ 300 m)
  latitude  Float?
  longitude Float?
  note      String?

  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId, type, dayKey])
  @@index([venueId, type, createdAt])
}

// ─────────────────────────────────────────────
// Moderasyon (App Store 1.2 / Google Play UGC politikası)
// ─────────────────────────────────────────────

enum ReportableContent {
  POST
  COMMENT
  REVIEW
}

enum ContentReportReason {
  SPAM
  ABUSE // hakaret, nefret söylemi, taciz
  MISLEADING
  OTHER
}

enum ModerationStatus {
  PENDING
  REMOVED // içerik kaldırıldı
  DISMISSED // ihlal yok
}

/// Kullanıcı şikayeti. Aynı kişi aynı içeriği bir kez şikayet eder.
/// Şikayet eden hesabını silerse kayıt kalır, kimliği boşaltılır: moderasyon geçmişi ve bekleyen şikayetler kaybolmaz.
model ContentReport {
  id           String              @id @default(cuid())
  reporterId   String?
  contentType  ReportableContent
  /// Post/Comment/Review kimliği (çok biçimli; FK yok)
  contentId    String
  reason       ContentReportReason
  note         String?
  status       ModerationStatus    @default(PENDING)
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter   User? @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, contentType, contentId])
  @@index([status, createdAt])
  @@index([contentType, contentId])
}

/// Engelleyen, engellenen kişinin içeriklerini görmez
model BlockedUser {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED // kimlik doğrulanamadı / hesap yok
}

/// Web formundan (uygulamaya erişemeyen kullanıcı) gelen hesap silme talebi. Kimlik doğrulandıktan sonra işlenir.
model AccountDeletionRequest {
  id          String                @id @default(cuid())
  email       String
  note        String?
  status      DeletionRequestStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}
